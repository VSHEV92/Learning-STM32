+unsigned char digit_to_7seg(char digit) {
+	switch(digit) {
+	  case '0': return ~(0x3F);
+	  case '1': return ~(0x06);
+	  case '2': return ~(0x5b);
+	  case '3': return ~(0x4F);
+	  case '4': return ~(0x66);
+	  case '5': return ~(0x6d);
+	  case '6': return ~(0x7d);
+	  case '7': return ~(0x07);
+	  case '8': return ~(0x7F);
+	  case '9': return ~(0x6F);
+	}
+	return 0;
+}
+
+
+void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
+
+  if (htim == &htim2) {
+	  shiftRegisters[0] = (1 << segment);
+	  shiftRegisters[1] = data_7seg[segment];
+	  ShiftRegister74HC595_update();
+
+	  segment = (segment + 1) % 4;
+  }
+
+  if (htim == &htim3) {
+
+	counter = (counter + 1) % 10000;
+
+    char counter_string[5];
+
+    snprintf(counter_string, sizeof(counter_string), "%04u", (unsigned int)counter);
+
+    for (int i = 0; i < 4; i++) {
+    	data_7seg[i] = digit_to_7seg(counter_string[i]);
+    }
+
+  }
+
+}
 
